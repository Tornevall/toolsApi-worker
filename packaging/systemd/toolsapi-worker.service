[Unit]
Description=Tornevall ToolsAPI Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toolsapi-worker
Group=toolsapi-worker
EnvironmentFile=@CONFIG_DIR@/.env
WorkingDirectory=@PREFIX@
ExecStart=@PREFIX@/.venv/bin/toolsapi-worker run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@PREFIX@

[Install]
WantedBy=multi-user.target
